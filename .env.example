# --- Lemario configuration ---
# Copy this file to ".env" and adjust the values.

# Path to the SQLite database built by scripts/build_index.py
LEMARIO_DATABASE_PATH=data/lemario.db

# --- Security ---
# Comma-separated list of valid API keys. If empty, the API runs OPEN
# (no key required) and logs a warning. Set at least one key in production.
LEMARIO_API_KEYS=

# Name of the header that carries the API key.
LEMARIO_API_KEY_HEADER=X-API-Key

# --- Rate limiting (slowapi) ---
# Global default limit applied to every endpoint.
LEMARIO_RATE_LIMIT_DEFAULT=120/minute
# Stricter limit for the definitions endpoint (it may hit external sources).
LEMARIO_RATE_LIMIT_DEFINITIONS=30/minute
# Looser limit for /words/exists (local lookup, no network; used by games
# to validate every guess).
LEMARIO_RATE_LIMIT_EXISTS=600/minute

# --- CORS ---
# Comma-separated list of allowed origins. Use "*" to allow all (dev only).
LEMARIO_CORS_ORIGINS=*

# --- External sources for definitions ---
LEMARIO_RAE_API_BASE=https://rae-api.com/api/words
LEMARIO_DLE_BASE=https://dle.rae.es
# Timeout (seconds) and retry count for external HTTP calls.
LEMARIO_HTTP_TIMEOUT=10
LEMARIO_HTTP_RETRIES=2

# --- Source word list (scripts/build_index.py) ---
LEMARIO_LIST_REPO=rubenperezm/ListadosPalabrasRAE
LEMARIO_LIST_BRANCH=main

# --- Frequency sources (scripts/enrich_frequency.py) ---
# CREA lemma frequencies (RAE, CC BY-SA 4.0). Download it yourself and put
# it here; it is never fetched automatically.
LEMARIO_CREA_PATH=data/crea_lemas.txt

# OpenSubtitles 2018 word counts (CC BY-SA 3.0).
LEMARIO_FREQ_LIST_URL=https://raw.githubusercontent.com/hermitdave/FrequencyWords/master/content/2018/es/es_full.txt
